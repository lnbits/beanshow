{
  "id": "beanshow",
  "name": "Bean Show",
  "version": "0.1.0",
  "short_description": "A candy-coloured 60-bean knockout show: five rounds, one crown.",
  "tile": "static/assets/icon.png",
  "extension_type": "wasm",
  "wasm": {
    "module": "wasm/module.wasm",
    "wit": "wasm/lnbits-extension.wit",
    "world": "beanshow",
    "exports": [
      {
        "name": "show-manifest",
        "visibility": "public"
      }
    ]
  },
  "ui_routes": [
    {
      "path": "/beanshow",
      "entrypoint": "ui/admin.html",
      "auth": "user"
    },
    {
      "path": "/beanshow/play",
      "entrypoint": "ui/play.html",
      "auth": "public"
    }
  ],
  "api_routes": [
    {
      "method": "GET",
      "path": "/manifest",
      "export": "show-manifest",
      "auth": "public"
    }
  ],
  "permissions": []
}
